@using Mictlanix.BE
@using Mictlanix.BE.Model;
@using Mictlanix.BE.Web.Helpers;
@model SalesQuote

@{
    Layout = WebConfig.PrintLayout;
    ViewBag.Title = Html.PrintFileName(Resources.SalesQuote, Model.Id);
    ViewBag.Store = Model.Store;
    ViewBag.TaxpayerName = null;
    ViewBag.Taxpayer = null;
    ViewBag.Address = Model.Store.Address;
}

<div class="row">
	<div class="col-xs-6 text-left">
		<div class="row">
			<div class="col-xs-12 uppercase">
				<h2>@Resources.Customer</h2>
			</div>
			<div class="col-xs-12">
				<p><span class="mylabel">@Resources.Name: </span>@Html.DisplayFor(x => x.Customer.Name)</p>
			</div>
			@if (Model.Contact != null)
			{
				<div class="col-xs-12">
					<p>
						<span class="mylabel">@Resources.Contact: </span>
						@Html.DisplayFor(x => x.Contact.Name)
					</p>
				</div>
				<div class="col-xs-12">
					@if (!string.IsNullOrEmpty(Model.Contact.Mobile))
					{
						<p>
							<span class="mylabel">@Resources.Mobile: </span> @Model.Contact.Mobile
						</p>
					}
					else if (!string.IsNullOrEmpty(Model.Contact.Phone))
					{
						<p>
							<span class="mylabel">@Resources.Phone: </span> @Model.Contact.Phone
							@if (!string.IsNullOrEmpty(Model.Contact.PhoneExt)) {
								@Resources.PhoneExt @Model.Contact.PhoneExt
							}
						</p>
					}
				</div>
			}
			</div>
	</div>
	<div class="col-xs-6 text-right">
		<div class="row">
			<div class="col-xs-12" @*style="width:200px; position:fixed; top:165px; right:-20px;"*@>
				<h2 class="text-right uppercase">@Resources.SalesQuote @Html.DisplayFor(x => x.Id)</h2>
			</div>
			<div class="col-xs-12 uppercase">
				<h4>&nbsp;</h4>
			</div>
			<div class="col-xs-12">
				<p><span class="mylabel">@Resources.DateTime: </span>@Html.DisplayFor(x => x.Date)</p>
			</div>
			<div class="col-xs-12">
				<p></p>
			</div>
			<div class="col-xs-12">
				<p><span class="mylabel">@Resources.DueDate: </span>@Html.DisplayFor(x => x.DueDate)</p>
			</div>
			<div class="col-xs-12">
				<p></p>
			</div>
		</div>
	</div>
	<div class="col-xs-12 text-left">
		@if (!string.IsNullOrEmpty(Model.Comment))
		{
			<div class="col-xs-12">
				<p><span class="mylabel">@Resources.Comment</span></p>
			</div>
			<div class="col-xs-12">
				<p>@Model.Comment</p>
			</div>
		}
		@if (Model.ShipTo != null)
		{
			<div class="col-xs-12">
				<p><span class="mylabel">@Resources.ShipTo</span></p>
			</div>
			<div class="col-xs-12">
				<p>
					@Model.ShipTo.Street
					@Model.ShipTo.ExteriorNumber
					@Model.ShipTo.InteriorNumber
					@Model.ShipTo.Neighborhood,
					@Model.ShipTo.Borough
					@Model.ShipTo.State,
					@Model.ShipTo.Country,
					@Model.ShipTo.PostalCode
				</p>
			</div>
		}
	</div>
</div>
<div class="row">
	
</div>

<table  style="border-spacing:0 4px;border-collapse: separate;">
    <thead>
        <tr>
            <th class="col-xs-3 text-center">@Resources.ProductCode</th>
            <th class="col-xs-6 text-center">@Resources.ProductName</th>
            <th class="col-xs-1 text-center">@Resources.Price</th>
            <th class="col-xs-1 text-center">@Resources.Quantity</th>
            <th class="col-xs-1 text-center">@Resources.Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Details)
								{
												//item.Price += item.PriceIncrement;
            <tr class="alt">
                <td class="text-left">@Html.DisplayFor(x => item.ProductCode)</td>
                <td class="text-left">
					@Html.DisplayFor(x => item.ProductName)
				@if (!string.IsNullOrEmpty (item.Comment)) {
					<br>
					@Html.DisplayFor(x => item.Comment)
				}
				</td>
                <td class="nowrap text-right">@Html.DisplayFor(x => item.UnitPriceWithDiscount)</td>
                <td class="nowrap text-center">@Html.DisplayFor(x => item.Quantity)</td>
                <td class="nowrap text-right">@Html.DisplayFor(x => item.Total)</td>
            </tr>
        }
    </tbody>
</table>

<div style="min-height: 2.2mm; border-top: #333 solid 3px; border-bottom: #333 solid 1px"></div>

<table>
	<tfoot>
		<tr>
			<td rowspan="3" class="col-xs-10 text-center" style="vertical-align:middle">
				<p style="border-top: solid black 1px; border-bottom:solid black 1px; margin: 0 2cm 0 2cm;">
					@Html.CurrencyToString(Model.Total, Model.Currency)
				</p>
			</td>
			<td class="col-xs-1 nowrap text-right">@Resources.Subtotal</td>
			<td class="col-xs-1 nowrap text-right">@Html.DisplayFor(x => x.Subtotal)</td>
		</tr>
		<tr>
			<td class="col-xs-1 nowrap text-right">@Resources.Taxes</td>
			<td class="col-xs-1 nowrap text-right">@Html.DisplayFor(x => x.Taxes)</td>
		</tr>
		<tr>
			<td class="col-xs-1 nowrap text-right">@Resources.Total</td>
			<td class="col-xs-1 nowrap text-right">@Html.DisplayFor(x => x.Total)</td>
		</tr>
		@if (Model.Discount > 0)
		{
			<tr>
				<td class="text-center">
					@*<text>@string.Format(Resources.SavingOnSalesQuote, Model.Details.Sum(x => x.Total * x.DiscountRate))</text>*@
				</td>
			</tr>
		}
	</tfoot>
</table>

<div class="row">
	<div class="text-center" style="margin-top:15mm">
		@Resources.CreatedBy,<br/>
		@Html.DisplayFor(x => Model.SalesPerson.Name)
	</div>
</div>
