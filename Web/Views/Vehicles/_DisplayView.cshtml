@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@model ServiceOrder


<fieldset>
	<div class='row'>
		<div class='col-xs-8'>
	  		<dl class=''>
				<dt>@Resources.Truck</dt>
				<dd>@Html.DisplayFor(x => x.Vehicle.NickName)</dd>
				<dt>@Resources.Notifier</dt>
				<dd>@Html.DisplayFor(x => x.Notifier.Nickname)</dd>
				<dt>@Resources.BreakdownReport</dt>
				<dd>@Html.DisplayFor(x => x.ProblemDescription)</dd>
			</dl>
		</div>
	  	<div class='col-xs-4'>
	  		<dl class='dl-horizontal'>
				<dt>@Resources.Id</dt>
				<dd>
					<span>@Html.DisplayFor(x => x.Id)</span>
				</dd>
				<dt>@Resources.Date</dt>
				<dd>@Html.DisplayFor(x => x.Date)</dd>
			</dl>
  		</div>
	</div>
</fieldset>