@using Mictlanix.BE.Model
@using Mictlanix.BE
@using Mictlanix.BE.Web.Models
@using Mictlanix.BE.Web.Helpers

@model Search<ServiceOrder>

@{
	var CurrentUser = Html.CurrentUser() ?? new User();
	var Privilege = Html.GetPrivilege(CurrentUser, SystemObjects.VehicleServiceOrders);

	ViewBag.Title = Resources.ServiceTruckOrders;
}

<table class="table-condensed">
	<thead>
		<tr>
			<th>@Resources.Id</th>
			<th>@Resources.Employee</th>
			<th>@Resources.Truck</th>
			<th>@Resources.StartDate</th>
			<th>@Resources.ServiceDescription</th>
			<th>@Resources.Cancelled</th>
			<th>@Resources.Completed</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.Results)
		{
			<tr>
				<td>@Html.DisplayFor(x => item.Id)</td>
				<td>@Html.DisplayFor(x => item.Notifier.Nickname)</td>
				<td>@Html.DisplayFor(x => item.Vehicle.Name)</td>
				<td>@Html.DisplayFor(x => item.CreationTime)</td>
				<td>@Html.DisplayFor(x => item.ProblemDescription)</td>
				<td>@Html.DisplayFor(x => item.IsCancelled)</td>
				<td>@Html.DisplayFor(x => item.IsCompleted)</td>
				<td class="action-buttons">
					@if (Privilege.AllowDelete)
					{
						@Html.ActionLink(" ", "DeleteServiceOrder", new { id = item.Id }, new { @class = "button icon delete icon-only open-modal", title = Resources.Delete, data_modal_id = "service-order-modal" })
					}
					@if (Privilege.AllowUpdate && !item.IsCompleted && !item.IsCancelled)
					{
						@Html.ActionLink(" ", "EditServiceOrder", new { id = item.Id }, new { @class = "button icon edit icon-only", title = Resources.Edit })
					}
				</td>
			</tr>
		}
	</tbody>
	<tfoot></tfoot>
</table>

<div class="buttons right">
	<label class='button left'>@Model.ToString()</label>@if (Model.HasPrev)
	{<a class='button middle icon prev icon-only paging' title='@Resources.PrevPage' href='javascript:void(0)'></a>}@if (Model.HasNext)
	{<a class='button right icon next icon-only paging' title='@Resources.NextPage' href='javascript:void(0)'></a>}
</div>


<script type="text/javascript">
    bindModal('.open-modal');

    $('a.paging').click(function (e) {
        var offset=@Model.Offset;

        if($(this).hasClass('next')) {
            offset+=@Model.Limit;
        } else {
            offset-=@Model.Limit;
        }

        e.preventDefault();
        $('#activity-indicator').show();
        $('#search-results').hide();

        $.post('@Url.Action("ServiceOrders")', { Pattern: '@Model.Pattern', Offset: offset, Limit: @Model.Limit }, function(data) {
            $('#search-results').html(data);
            $('#search-results').show();
            $('#activity-indicator').hide();
        });
    });

</script>