@using Mictlanix.BE.Model
@using Mictlanix.BE
@model ServiceOrder

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h3>@Resources.TechnicalService</h3>
</div>

<div class="modal-body">
    @using (Ajax.BeginForm("CreateServiceOrder", "Vehicles",
		new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "service-order-modal-content" },
		new { @class = "modal-form"}))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)
        <div class="form-horizontal">
            @Html.LabelFor(model => model.Vehicle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-xs-12">
                @Html.EditorFor(model => model.VehicleId, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.VehicleId, "", new { @class = "text-danger" })
            </div>
        </div>

		<div class="form-horizontal">
			@Html.LabelFor(model => model.Notifier, htmlAttributes: new { @class = "control-label col-md-2" })
			<div class="col-xs-12">
				@Html.EditorFor(model => model.NotifierId, new { htmlAttributes = new { @class = "form-control" } })
				@Html.ValidationMessageFor(model => model.NotifierId, "", new { @class = "text-danger" })
			</div>
		</div>
        <div class="form-horizontal">
			@Html.LabelFor(model => model.ProblemDescription, htmlAttributes: new { @class = "control-label col-md-2" })
			<div class="col-xs-12">
				@Html.EditorFor(model => model.ProblemDescription, new { htmlAttributes = new { @class = "form-control" } })
				@Html.ValidationMessageFor(model => model.ProblemDescription, "", new { @class = "text-danger" })
			</div>
		</div>
	 }
</div>
<div class="clear"></div>
<div class='modal-footer'>
    <button type='button' class='btn btn-default' data-dismiss='modal'>@Resources.Discard</button>
    <button type='submit' class='btn btn-primary' onclick='$("#service-order-modal form").submit();'>@Resources.Create</button>
</div>