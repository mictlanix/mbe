@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@model CustomerRefund

<ul class='labeled-frames'>
    <li>
    	<span class='caption'>@Resources.Subtotal</span>
    	<span class='value'>@Html.DisplayFor(x => x.Subtotal) @Html.DisplayFor(x => x.Currency)</span>
    @if (Model.Currency != WebConfig.BaseCurrency) {
        <span class='value muted'>(@Html.DisplayFor(x => x.SubtotalEx) @WebConfig.BaseCurrency)</span>
    }
    </li>
@if (Model.Discount > 0m) {
    <li>
    	<span class='caption'>@Resources.Discount</span>
        <span class='value'>@Html.DisplayFor(x => x.Discount) @Html.DisplayFor(x => x.Currency)</span>
    @if (Model.Currency != WebConfig.BaseCurrency) {
        <span class='value muted'>(@Html.DisplayFor(x => x.DiscountEx) @WebConfig.BaseCurrency)</span>
    }
    </li>
}
    <li>
    	<span class='caption'>@Resources.Taxes</span>
        <span class='value'>@Html.DisplayFor(x => x.Taxes) @Html.DisplayFor(x => x.Currency)</span>
    @if (Model.Currency != WebConfig.BaseCurrency) {
        <span class='value muted'>(@Html.DisplayFor(x => x.TaxesEx) @WebConfig.BaseCurrency)</span>
    }
    </li>
    <li>
    	<span class='caption'>@Resources.Total</span>
        <span class='value'>@Html.DisplayFor(x => x.Total) @Html.DisplayFor(x => x.Currency)</span>
    @if (Model.Currency != WebConfig.BaseCurrency) {
        <span class='value muted'>(@Html.DisplayFor(x => x.TotalEx) @WebConfig.BaseCurrency)</span>
    }
    </li>
</ul>

@*<div>balance @Model.SalesOrder.Balance</div>
<div>refund @Model.Total</div>*@

<script type="text/javascript">

    $(document).ready(function () {
        if (@Model.SalesOrder.Balance < @Model.Total) {
            var order_id = @Model.SalesOrder.Id;
            var is_paid = @Json.Encode(Model.SalesOrder.IsPaid);
            @*var refund = @((Model.Total - Model.SalesOrder.Balance));*@
            var refund_to_credit_note = @Json.Encode(WebConfig.RefundToCreditNote);

            var info = "";

            if (is_paid == true) {
                if (refund_to_credit_note == true) {
                    info = "@Html.Raw(string.Format(Resources.RefundToCreditNote,Model.Id, Model.Total - Model.SalesOrder.Balance, Model.Currency))";
                } else {
                    info = "@Html.Raw(Resources.Refund + ": " + (Model.Total - Model.SalesOrder.Balance).ToString("c"))";
                }
            } else {
                info = "@Html.Raw(string.Format(
                       Resources.RefundPaysSalesOrder, Model.SalesOrder.Id, Model.Total - Model.SalesOrder.Balance,
                        Model.SalesOrder.Currency)
                       )"
            }
            $('.alert').css("display", 'block');
            $('.alert').text(info).fadeIn(1).delay(5000)
        }
        else {
            console.log("sigo debiendo");
            $('.alert').css("display", 'none');
        }

        if (@Model.Total <= 0) {
            $("#confirm-button").addClass("hide")
        } else {
            $("#confirm-button").removeClass("hide")
        }
				});
</script>