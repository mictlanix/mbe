								<button id='complete' class="refund" type='submit'>@Resources.Complete</button>

</div>
<div class='clearfix'></div>
<script type='text/javascript'>
					$(function () {
									$('[data-toggle="tooltip"]').tooltip();
					});

						$(".refund").click(function () {
									var type = $(this).data('value');

										$.post('@Url.Action("Confirm", new { id = Model.Id })',
														{ 'method': type }, function (detail) {
																		location.reload();
																		//window.location.href = window.location.host + "/CustomerRefunds";

													}, "json").fail(function (e) {
																	console.log(e);
																	DisplayErrorMessage(e.responseText)
													});
						});

									function DisplayErrorMessage(errorMessage) {
													$('.alert').text(errorMessage);
													$('.alert').fadeIn(1).delay(5000).fadeOut(1000);
									}
</script>


