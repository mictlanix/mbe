								<img src='@Url.Action("QRCodeUrl", "Barcodes" ,new { url = Model.DeliveryOrder.ShipTo.Link })'
													alt='@Html.DisplayFor(x => x.DeliveryOrder.Id)' title='@Html.DisplayFor(x => x.DeliveryOrder.Id)'>
								<p>@Html.DisplayFor(x => x.DeliveryOrder.Id)</p>
				}*@
