@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Controllers.Mvc
@using Mictlanix.BE.Web.Models
@using Gma.QrCodeNet.Encoding;
@using Gma.QrCodeNet.Encoding.Windows.Render;
@model DeliveryViewModel

@{
				Layout = WebConfig.ReceiptLayout;
				ViewBag.Title = Resources.DeliveryOrder;
				ViewBag.Store = Model.DeliveryOrder.Store;
				ViewBag.TaxpayerName = Model.DeliveryOrder.Store.Taxpayer.Name;
				ViewBag.Taxpayer = Model.DeliveryOrder.Store.Taxpayer.Id;
				ViewBag.Address = Model.DeliveryOrder.Store.Address;
				var unpaids = Model.SalesOrders;
}

<div class="row">
				<div class="col-xs-12 text-left shipandcontact">
								<div class="row">
												<div class="col-xs-12">
																<h3 class="text-right uppercase mylabel" style="display:inline-block">@Resources.DeliveryOrderId</h3>
																<h3 style="display:inline-block">@Html.DisplayFor(x => x.DeliveryOrder.Id)</h3>
												</div>
												<div class="col-xs-12 uppercase">
																<h3 class="text-left">@Resources.Customer: @Html.DisplayFor(x => x.DeliveryOrder.Customer.Name)</h3>
												</div>
												<div class="col-xs-12">
																<p><span class="mylabel">@Resources.DeliveryDate</span>: @Html.DisplayFor(x => x.DeliveryOrder.Date)</p>
												</div>
												@foreach (var unpaid in unpaids) {
												<div class="col-xs-12">
																<h2 style="font-size:10px;">
																				@Html.DisplayFor(x => unpaid.Id) @unpaid.Terms.GetDisplayName()
																				@if (!unpaid.IsPaid) {
																								if(unpaid.Terms == PaymentTerms.Immediate) {
																												<span>@Resources.No @Resources.Paid</span>
																								}
																								else {
																												if(unpaid.DueDate < DateTime.Today) {
																																<span>Vencido</span>
																													}
																													else {
																																<span>Por Cobrar</span>
																												}

																								}
																				}				
																</h2>
												</div>
												}
												<div class="col-xs-12">
																<p><span class="mylabel">@Resources.Contact</span>:
																				@Html.DisplayFor(x => x.DeliveryOrder.Contact.Name)
																				@Html.DisplayFor(x => x.DeliveryOrder.Contact.Mobile)
																</p>
												</div>
												<div class="col-xs-12">
																						<p><span class="mylabel">@Resources.ShipTo: </span> @Model.DeliveryOrder.ShipTo.ToString() <br />
																								@Html.SafeDisplayFor(x => x.DeliveryOrder.ShipTo.Comment)</p>
												</div>
												@if (!string.IsNullOrEmpty(Model.DeliveryOrder.Comment)) {
																<div class="col-xs-12">
																		@Resources.Comment:		@Html.SafeDisplayFor(x => x.DeliveryOrder.Comment)
																</div>
												}
								</div>
				</div>
				<div class="col-xs-12 text-right shipandcontact">
								<div class="row">
												@*<div class="col-xs-12">
																<p><span class="mylabel">@Resources.Serial</span>: @Html.DisplayFor(x => x.DeliveryOrder.Serial)</p>
																<p></p>
												</div>*@
												
								</div>
				</div>
</div>

<div style="min-height: 2.2mm; border-top: #333 solid 1px; border-bottom: #333 solid 3px"></div>

<table class="details" style="border-spacing:0 4px;border-collapse: separate;">
				<thead>
								<tr>
												<td>@Resources.Quantity</td>
												<td class="text-center">@Resources.Name</td>
												<td>@Resources.SalesOrder</td>
								</tr>
				</thead>
				<tbody>
								@foreach (var item in Model.DeliveryOrder.Details.Where(x => x.Quantity > 0))
								{
												<tr class="alt">
																<td class="">
																				@Html.DisplayFor(x => item.Quantity)
																				<br />
																				@Html.DisplayFor(x => item.Product.UnitOfMeasurement.Name)
																</td>
																<td class="">@Html.DisplayFor(x => item.ProductName)</td>
																<td class="">@Html.DisplayFor(x => item.OrderDetail.SalesOrder.Id)</td>
												</tr>
																<tr>
																				<td colspan="3">@Html.SafeDisplayFor(x => item.OrderDetail.Comment)</td>
																</tr>
												<tr>
																<td class="line" colspan="3"></td>
												</tr>
								}
				</tbody>
</table>

<div style="min-height: 2.2mm; border-top: #333 solid 3px; border-bottom: #333 solid 1px"></div>

@if (Model.PaymentsOnDelivery.Count() > 0)
{
				<span>Pagos Pendientes</span>
				foreach (var item in Model.PaymentsOnDelivery)
				{
								item.Payment.Amount *= (item.Payment.Commission + 1.0m);
								<div>
												<ul>
																<li>
																				<span>@Resources.SalesOrderId: @Html.DisplayFor(x => item.SalesOrder.Id)</span><br />
																				<span>@Resources.Amount: <b>@Html.DisplayFor(x => item.Payment.Amount)</b></span><br />
																				<span>@Resources.PaymentMethod: @item.Payment.Method.GetDisplayName()</span>
																</li>
												</ul>
								</div>
				}
}

@{
				var orders = Model.SalesOrders.Where(x => x.Terms == PaymentTerms.Immediate && !x.IsPaid);
				var collect = orders.Sum(x => x.Balance);
				}

@if (collect > 0)
{
				<div class="text-center" style="font-size:large;">
								@*<span>@Resources.Balance</span>*@

								<div>
												@Resources.ReceivableAmount : @collect.ToString("c")
								</div>

				</div>
}

@if (Model.DeliveryOrder.ShipTo != null && Model.DeliveryOrder.ShipTo.Link != null)
{
				<div class="row">
								<div class="col-xs-12">@Model.DeliveryOrder.ShipTo.Nickname</div>
				</div>
				<div class="row">
								<div class="col-xs-12">@Resources.AddressLinkURL:</div>
								<div class="col-xs-12"> @Model.DeliveryOrder.ShipTo.Link</div>
				</div>
				<div class="row">
								<div class="col-xs-4"></div>
								<div class="col-xs-4">
												<img class="" style="" src='@Url.Action("QRCodeUrl", "Barcodes", new { url = Model.DeliveryOrder.ShipTo.Link })' />
								</div>
				</div>
}

<div style="min-height: 2.2mm; border-top: #333 solid 3px; border-bottom: #333 solid 1px"></div>
<div class="row" style="margin-top:20mm">
				<div class="col-xs-8 col-xs-offset-2 text-center" style="border-top: #333 solid 1px">
								@Resources.PersonReceipt<br />
								@Resources.NameAndSignature
				</div>
</div>

