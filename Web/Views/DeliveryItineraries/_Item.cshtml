@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Controllers.Mvc
@using Mictlanix.BE.Web.Utils
@model DeliveriesItinerary

@{
				var CurrentUser = Html.CurrentUser() ?? new User();
				var Privilege = Html.GetPrivilege(CurrentUser, SystemObjects.DeliveryItineraries);
}

<tr id='id:@Model.Id'>
				<td class="">@Html.DisplayFor(x => x.Id)</td>
				<td class="">@Html.DisplayFor(x => x.Date)</td>
				<td class="center">@Html.DisplayFor(x => x.VehicleOperator.Operator.Nickname)</td>
				<td class="center">@Html.DisplayFor(x => x.Vehicle.NickName)</td>
				<td class="">@Html.DisplayFor(x => x.Comment)</td>
				<td class="">@Model.Details.Select(x => x.DeliveryOrderDetail.DeliveryOrder.Id).Distinct().Count()</td>
				@*<td class="">@Html.DisplayFor(x => x.IsCompleted)</td>
				<td class="">@Html.DisplayFor(x => x.IsCancelled)</td>*@
				<td class=""></td>
				@*<td class="bool">@Html.DisplayFor(x => x.IsCancelled)</td>*@
								<td class="actions">
												@if (Privilege.AllowRead)
												{
																@Html.ActionLink(" ", "View", new { id = Model.Id }, new
																{
																				@class = "button icon view icon-only",
																								title = Resources.Details
																})
												}


												@if (Privilege.AllowUpdate && !Model.IsCompleted && !Model.IsCancelled)
												{
																@Html.ActionLink(" ", "Edit", new { id = Model.Id }, new { @class = "button icon edit icon-only", title = Resources.Edit })
												}

												@if (Privilege.AllowDelete && !Model.IsCancelled)
												{
																@*@Html.ActionLink(" ", "Cancel", new { id = Model.Id }, new { @class = "button icon delete icon-only",
												title = Resources.Delete })*@
																<a class='button icon-only icon delete to-validate' title='@string.Format(Resources.Cancel)'
																			data-type='checklist' data-placement='bottom' data-pk='@Model.Id' data-source='{}' data-value='@Model.Id'
																			data-url='@Url.Action("Cancel", new { id = Model.Id })' data-emptytext='' data-emptyclass=''></a>
												}
								</td>
</tr>


