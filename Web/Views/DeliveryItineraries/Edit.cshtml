@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model DeliveriesItinerary

@{
				ViewBag.Title = Resources.Edit;
}

<h2>@Resources.DeliveryItinerary</h2>

<div id='master-section'>
				@Html.Partial("_EditorView")
</div>
<div class='control-group text-right'>
				<a id='add-order' class='btn btn-default editable' data-url='@Url.Action("AddDeliveryOrder", new { id = Model.Id })'
							data-type='text' data-placement='left' data-pk='@Model.Id' data-value=''
							data-display='false' data-emptytext='' data-emptyclass='' data-highlight='false'>
								<i class='icon-plus'></i>@Resources.Add @Resources.DeliveryOrder
				</a>

				<a id='add-orders' class='btn btn-default'
							data-pk='@Model.Id'>
								<i class='icon-plus'></i> Cargar Órdenes de Envío del Día
				</a>
				@*<a id='remove-orders' class='btn btn-default'
											data-pk='@Model.Id'>
												<i class='icon-remove'></i> Remover Todo
								</a>*@
</div>
<div id='details-section'>
				<div id='addresses-container' data-url='@Url.Action("GetAddresses", new { id = Model.Id })'>
								<h2>Rutas</h2>
								@Html.Partial("_Addresses",
					Model.DeliveryOrders.Select(x =>
					new DeliveryItineraryAddressViewModel { DeliveryOrder = x, Itinerary = Model }).ToList())
				</div>
				@*<div id='items-container' data-url='@Url.Action("GetDetails", new { id = Model.Id })'>
												<h2>Partidas</h2>
												@Html.Partial("_Items", Model.Details)
								</div>*@
</div>
<div class="warning-message alert alert-danger alert-dismissible fade in" style="display:none;"></div>
<div class='clearfix'></div>
<div id='back-to-list' class='pull-left'>
				@Html.ActionLink(Resources.BackToList, "Index", new { }, new { @class = "button icon back" })
</div>
<div id='confirm-button' class='pull-right @(Model.Details.Count == 0 ? "hide" : "")'>
				@using (Html.BeginForm("Confirm", "DeliveryItineraries", new { id = Model.Id }))
				{
				}
				<button id='complete' type='submit'>@Resources.Complete</button>
</div>
<div class='clearfix'></div>
<script type='text/javascript'>
				$('#add-orders').on("click", function (e) {
												$.post('@Url.Action("AddDeliveryOrdersOfTheDay", new { id = Model.Id })', function (detail) {
																location.reload();

								}, "json").fail(function (e) {
												console.log(e);
												DisplayErrorMessage(e.responseText)
												$('#product-search').tokenInput('clear');
								});
				});
				$("#add-order").editable({
								success: function (response, newValue) {
												$("#addresses-container").loadUrl();
								}
				});

				$("#complete").on('click', function () {
												$.post('@Url.Action("Confirm", new { id = Model.Id })', function (detail) {
																location.href = '@Url.Action("View","DeliveryItineraries", new { id = Model.Id })'
								}, "json").fail(function (e) {
												DisplayErrorMessage(e.responseText)
				});

				});
				function DisplayErrorMessage(errorMessage) {
								$('.warning-message').text(errorMessage);
								$('.warning-message').fadeIn(1).delay(5000).fadeOut(1000);
				}
</script>
<style type='text/css'>
				ul.token-input-list {
								width: 100%;
				}
</style>