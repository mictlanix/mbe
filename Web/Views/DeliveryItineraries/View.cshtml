@using Mictlanix.BE.Model
@using Mictlanix.BE

@model PurchaseRequest

<div class="modal-header">
	<button type='button' class='close' data-dismiss='modal'>&times;</button>
	<h3>@Resources.PurchaseRequest</h3>
</div>
<div class="modal-body">
	@using (Ajax.BeginForm("Delete", "PurchaseRequests",
		new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "purchase-request-modal-content" },
		new { @class = "modal-form" }))
	{
		<div class="form-horizontal">
			@Html.DisplayForModel()
		</div>
	}
</div>
<div class="modal-footer">
	<button type='button' class='btn btn-default' data-dismiss='modal'>@Resources.Discard</button>
</div>
