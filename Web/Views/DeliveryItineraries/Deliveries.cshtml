@if (Privilege.AllowRead)
{
				<div class='tabbable'>
								<ul class='nav nav-tabs'>
												@for (int i = 0; i < Model.Count; i++)
												{
																<li  class="@(Model[i].Selected?"active":"")"><a href='#tab-@i' data-toggle='tab'>@Model[i].Title</a></li>

												}
								</ul>
								<div class="tab-content">
												@for (int i = 0; i < Model.Count; i++)
												{
																<div id='tab-@i' class='tab-pane @(Model[i].Selected?"active":"")'>
																				@Html.Partial("_DeliveryOrderDetailsDisplayView", Model[i].Details)
																</div>
												}
								</div>
				</div>
}
<script type="text/javascript">
				bindModal('.open-modal');

				$(function () {
								$('#new').editable({
												success: function (response, newValue) {
																window.location.replace(response.url);
																setTimeout(function () { $('#add-items').editable('setValue', ''); }, 500);
												}
								}).removeClass('editable-click');
				});
</script>