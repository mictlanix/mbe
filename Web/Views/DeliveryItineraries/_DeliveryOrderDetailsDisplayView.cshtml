@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@model IEnumerable<DeliveryOrderDetail>

@{
    var groupes = Model.GroupBy(x => new { x.DeliveryOrder.ShipTo, x.DeliveryOrder.Contact, x.DeliveryOrder.Customer },
								(key, g) => new {Contact = key.Contact, ShipTo = key.ShipTo, Customer = key.Customer, Result = g.ToList()}).ToList();
    }

<table id="items" class="list-items">
				@*<thead>
								<tr>
												<th>@Resources.SalesOrder</th>
												<th>@Resources.DeliveryOrder</th>
												<th>@Resources.DeliveryOrder</th>
												<th>@Resources.ProductName</th>
												<th>@Resources.Quantity</th>

								</tr>
				</thead>*@

				@if(Model.Count() <= 0) {
								<span>@Resources.NotPendingShippingRequestsYet</span>
				}

				@foreach (var group in groupes)
				{
								<tr class="alert-info">
												<td colspan="2">@Html.DisplayFor(x => group.Customer.Name)</td>
												<td colspan="2">
																@if (group.Contact != null)
																{
																				@group.Contact.ToString() <br />
																				<span>@Resources.Mobile</span> @group.Contact.Mobile
																}
												</td>
												<td colspan="5">
																@if (group.ShipTo != null)
																{

																				@group.ShipTo.InteriorNumber<span>&nbsp;</span>
																				@group.ShipTo.StreetAndNumber<span>&nbsp;</span>
																				@group.ShipTo.Neighborhood<span>&nbsp;</span>
																				@group.ShipTo.Locality<span>&nbsp;</span>
																				@group.ShipTo.Borough<span>&nbsp;</span>
																				@group.ShipTo.City<span>&nbsp;</span>
																}
												</td>
								</tr>
								<tr class="bg-info">
												<td>@Resources.SalesOrder</td>
												<td>@Resources.DeliveryOrder</td>
												<td>@Resources.SalesPerson</td>
												<td>@Resources.ConfirmationDate</td>
												<td>@Resources.Product</td>
												<td>@Resources.QuantityToDeliver</td>
												<td>@Resources.PromiseDate</td>
												<td class="col-lg-2">@Resources.DeliveryItineraries</td>
												<td></td>
								</tr>
								foreach (var item in group.Result)
								{
												@Html.Partial("_DeliveryOrderDetailDisplayView", item)
								}
				}
</table>