@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model IEnumerable<dynamic>

<div class="table-responsive">
<table class='debts'>
				<thead>
								<tr>
												<th class='center'>@Resources.CustomerId</th>
												<th class='center'>@Resources.Customer</th>
												<th class='center'>@Resources.Customer @Resources.Code</th>
												<th class='center'>@Resources.SalesOrders</th>
												<th class='center'>@Resources.Total</th>
												<th class='center'>@Resources.Refund</th>
												<th class='center'>@Resources.Paid</th>
												<th class='center'>@Resources.Balance</th>
												<th class='center'>@Resources.PendingAtCashier</th>
												<th class='center'>@Resources.PaymentsInAdvance</th>
												<th class='center'>@Resources.CreditNotes</th>
												<th class='center'>@Resources.NetBalance</th>
												<th class='center'>@Resources.ExpiredCredits</th>
												<th class='center'>@Resources.ExpirationDate</th>
												<th class='center'></th>
								</tr>
				</thead>

				<tbody>
								@foreach (var item in Model)
								{
												var warning = item.OnDelivery > 0 || item.Balance < 0;
												<tr class="@( warning ? "warning" : string.Empty)">
																<td class="text-center">
																				@item.CustomerId.ToString().PadLeft(5, '0')
																</td>
																<td class='text-left'>
																				@item.CustomerName
																				<small class="debt-credit">
																								@if(item.CreditLimit > 0 && item.CreditDays > 0) {
																												@:@Resources.CreditLimit: @item.CreditLimit.ToString("C") &middot; @Resources.CreditDays: @item.CreditDays
																								}
																								else {
																												@Resources.CreditLimitIsNotSet
																								}
																				</small>
																</td>
																<td class='number'>@item.CustomerCode</td>
																<td class="number">@item.NumberOfOrders	</td>
																<td class="number">@item.Total.ToString("C")</td>
																<td class="number">@(item.Refunds > 0 ? item.Refunds.ToString("C") : "")</td>
																<td class="number">@(item.Payment > 0 ? item.Payment.ToString("C") : "")</td>
																<td class='currency'>@item.Balance.ToString("C")</td>
																<td class='currency'>@(item.PendingAtCashier < 0 ? item.PendingAtCashier.ToString("C") : "")</td>
																<td class='currency'>@(item.Prepayments > 0 ? item.Prepayments.ToString("C") : "")</td>
																<td class='currency'>@(item.CreditNotes > 0 ? item.CreditNotes.ToString("C") : "")</td>
																<td class='currency'>@item.NetBalance.ToString("C")</td>
																<td class='currency'>@(item.NumberOfOverdueOrders > 0 ? item.NumberOfOverdueOrders : string.Empty)</td>
																<td class='date'>@(item.NumberOfOverdueOrders > 0 ?
																																								item.OldestOverdueDate.ToString("yyyy-MM-dd")
																																								:string.Empty)</td>
																<td class="text-center">
																				<a href="@Url.Action("CustomerDebtReport", new { id = item.CustomerId })" target="_blank" title="@Resources.CustomerDebt">
																								<span class="glyphicon glyphicon-list-alt"></span>
																				</a>
																</td>
												</tr>
								}
								<tr class="warning">
												<td class="text-right" colspan="7"><b>@Resources.Balance</b></td>
												<td><b>@Model.Where(x => (decimal)x.Balance < 0).Sum(x => (decimal)x.Balance).ToString("c")</b></td>
												<td><b>@Model.Sum(x => (decimal)x.PendingAtCashier).ToString("c")</b></td>
												<td><b>@Model.Sum(x => (decimal)x.Prepayments).ToString("c")</b></td>
												<td><b>@Model.Sum(x => (decimal)x.CreditNotes).ToString("c")</b></td>
												<td><b>@Model.Sum(x => (decimal)x.NetBalance).ToString("c")</b></td>
								</tr>
				</tbody>
</table>
</div>
<style type="text/css">
				table.debts th { vertical-align: bottom; }
				table.debts td.number, table.debts td.currency, table.debts td.date { white-space: nowrap; }
				table.debts small.debt-credit { display: block; margin-top: 2px; font-weight: normal; color: #777; }
</style>
<script type='text/javascript'>
				$('[data-toggle="tooltip"]').tooltip();
</script>