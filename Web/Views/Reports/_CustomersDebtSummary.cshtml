@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model IEnumerable<dynamic>

<table class='debts'>
				<thead>
								<tr>
												<th class='center'>@Resources.CustomerId</th>
												<th class='center'>@Resources.Customer</th>
												<th class='center'>@Resources.Customer @Resources.Code</th>
												<th class='center'>@Resources.CreditLimit</th>
												<th class='center'>@Resources.CreditDays</th>
												<th class='center'>@Resources.SalesOrders</th>
												<th class='center'>@Resources.Total</th>
												<th class='center'>@Resources.Refund</th>
												<th class='center'>@Resources.Paid</th>
												<th class='center'>@Resources.Balance</th>
												<th class='center'>@Resources.ExpiredCredits</th>
												<th class='center'>@Resources.ExpirationDate</th>
												<th class='center'></th>
								</tr>
				</thead>

				<tbody>
								@foreach (var item in Model)
								{
												var warning = item.OnDelivery > 0 || item.Balance < 0;
												<tr class="@( warning ? "warning" : string.Empty)">
																<td class="text-center">@item.CustomerId.ToString().PadLeft(5,'0')</td>
																<td class='text-left'>@item.CustomerName</td>
																<td class='text-left'>@item.CustomerCode</td>
																<td class="number">@item.CreditLimit.ToString("C")	</td>
																<td class="number">@item.CreditDays	</td>
																<td class="number">@item.NumberOfOrders	</td>
																<td class="number">@item.Total.ToString("C")</td>
																<td class="number">@(item.Refunds > 0 ? item.Refunds.ToString("C") : "")</td>
																<td class="number">@(item.Payment > 0 ? item.Payment.ToString("C") : "")</td>
																<td class='currency'>@item.Balance.ToString("C")</td>
																<td class='currency'>@(item.NumberOfOverdueOrders > 0 ? item.NumberOfOverdueOrders : string.Empty)</td>
																<td class='date'>@(item.NumberOfOverdueOrders > 0 ?
																																								item.OldestOverdueDate.ToString("yyyy-MM-dd")
																																								:string.Empty)</td>
																<td>@Html.ActionLink(Resources.CustomerDebt,"CustomerDebtReport",new {id = item.CustomerId }, new {target="_blank"})</td>
												</tr>
								}
								<tr class="warning">
												<td class="text-right" colspan="8"><b>@Resources.Balance</b></td>
												<td><b>@Model.Where(x => (decimal)x.Balance < 0).Sum(x => (decimal)x.Balance).ToString("c")</b></td>
								</tr>
				</tbody>
</table>
<script type='text/javascript'>
				$('[data-toggle="tooltip"]').tooltip();
</script>