@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model IEnumerable<Customer>

<table class=''>
				<thead>
								<tr>
												<th class='center'>@Resources.Customer</th>
												<th class='center'>@Resources.CreditLimit</th>
												<th class='center'>@Resources.CreditDays</th>
												<th class='center'>@Resources.Total</th>
												<th class='center'>@Resources.Refund</th>
												<th class='center'>@Resources.Paid</th>
												<th class='center'>@Resources.Balance</th>
												<th class='center'>@Resources.ExpiredCredits</th>
								</tr>
				</thead>
				<tbody>
								@foreach (var item in Model)
								{
												<tr>
																<td class='date'>@Html.DisplayFor(x => item.Name)</td>
																<td class="text-center">
																				@Html.ActionLink(item.Id.ToString(), "CustomerDebtReport", new { id = item.Id }, new { target = "_blank" })
																<td />
																<td>
																				@Html.DisplayFor(x => item.CreditLimit)
																</td>
																<td>
																				@Html.DisplayFor(x => item.CreditDays)
																</td>
																<td class="text-nowrap">
																<td />
																<td class='currency'>@item.Debt().ToString("C")</td>
												</tr>
								}
								<tr class="warning">
												<td colspan="4"><b>@Resources.Totals</b></td>
												<td><b>@Model.Sum(x => Model.Sum(y => y.Debt())).ToString("c")</b></td>
								</tr>
				</tbody>
</table>
<script type='text/javascript'>
				$('[data-toggle="tooltip"]').tooltip();
</script>