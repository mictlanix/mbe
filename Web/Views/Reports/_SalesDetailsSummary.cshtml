@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model IEnumerable<dynamic>

<table class='table table-condensed'>
				<thead>
								<tr>
												<th class='nowrap center'>@Resources.SalesOrder</th>
												<th class='nowrap center'>@Resources.ModificationTime</th>
												<th class='nowrap center'>@Resources.Details</th>
												<th class='nowrap center'>@Resources.Product</th>
												<th class='nowrap center'>@Resources.ProductCode</th>
												<th class='nowrap center'>@Resources.ProductName</th>
												<th class='nowrap center'>@Resources.Quantity</th>
												<th class='nowrap center'>@Resources.UnitOfMeasurement</th>
												<th class='nowrap center'>@Resources.Cost</th>
												<th class='center'>@Resources.Warehouse</th>
												<th class='center'>@Resources.Base</th>
												<th class='nowrap center'>@Resources.Discount</th>
												<th class='nowrap center'>@Resources.Price</th>
												<th class='nowrap center'>@Resources.Subtotal</th>
												<th class='nowrap center'>@Resources.SalesAgent</th>
												<th class='nowrap center'>@Resources.SalesPerson</th>
												<th class='nowrap center'>@Resources.Store</th>
												<th class='nowrap center'>@Resources.Paid</th>
												<th class='nowrap center'>@Resources.Status</th>
												<th class='nowrap center'>@Resources.PaymentTerms</th>
												<th class='nowrap center'>@Resources.Type</th>
												<th class='nowrap center'></th>
								</tr>
				</thead>
				<tbody>
								@foreach (var item in Model)
								{
												<tr>
																<td class='number'>@item.SalesOrder</td>
																<td class='date'>@item.ModificationTime.ToString("yyyy-MM-dd")</td>
																<td class='number'>@item.SalesOrderDetail</td>
																<td class='nowrap'>@(item.Product)</td>
																<td class='nowrap'>@(item.ProductCode)</td>
																<td class='nowrap'>@(item.ProductName)</td>
																<td class='nowrap'>@(item.Quantity)</td>
																<td class='nowrap'>@(item.UnitOfMeasure)</td>
																<td class='nowrap'>@(item.Cost.ToString("c"))</td>
																<td class='nowrap'>@(item.Warehouse)</td>
																<td class='nowrap'>@(item.BasePrice.ToString("c"))</td>
																<td class='nowrap'>@(item.Discount)</td>
																<td class='nowrap'>@(item.Price.ToString("c"))</td>
																<td class='nowrap'>@(item.Subtotal.ToString("c"))</td>
																<td class='nowrap'>@(item.SalesAgent)</td>
																<td class='nowrap'>@(item.SalesPerson)</td>
																<td class='nowrap'>@(item.Store)</td>
																<td class='nowrap'>@(item.Paid)</td>
																<td class='nowrap'>@(item.Received)</td>
																<td class='nowrap'>@(item.Terms)</td>
																<td class='nowrap'>@(item.Type)</td>
												</tr>
								}
				</tbody>
				<tfoot>
								<tr>
												<td class='right' colspan='7'>@*@Model.Count() @Resources.SalesOrders*@</td>
												<td class='number'><b>@*@Model.Sum(x => (decimal)x.TotalEx).ToString("c")*@</b></td>
												<td class='number'><b>@*@Model.Where(x => (CurrencyCode)x.Currency != WebConfig.BaseCurrency).Sum(x => (decimal)x.Total).ToString("c")*@</b></td>
								</tr>
								<tr>
												<td class='right' colspan='7'>@*@Model.Where(y => y.Refund != null).Count() @Resources.Refunds*@</td>
												<td class='number'><b>@*@Model.Where(y => y.Refund != null).Sum(x => (decimal)x.RefundEx).ToString("c")*@</b></td>
												<td class='number'><b>@*@Model.Where(x => (CurrencyCode)x.Currency != WebConfig.BaseCurrency && x.Refund != null).Sum(x => (decimal)x.Refund).ToString("c")*@</b></td>
								</tr>
				</tfoot>
</table>


