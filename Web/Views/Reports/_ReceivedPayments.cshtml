@using Mictlanix.BE
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@using Mictlanix.BE.Model
@model IEnumerable<CustomerPayment>

<table>
    <tr>
        <th class="nowrap">@Resources.SalesOrder</th>
        <th class="nowrap">@Resources.Date</th>
        <th class="nowrap">@Resources.Serial</th>
        <th class="nowrap">@Resources.CashSession</th>
        <th class="nowrap">@Resources.Customer</th>
        <th class="nowrap">@Resources.PaymentType</th>
        <th class="nowrap">@Resources.ReceivedPayments</th>
        <th class="nowrap">@Resources.Amount</th>
        <th class="nowrap">@Resources.Change</th>
        <th class="nowrap">@Resources.Balance</th>
        <th class="nowrap">@Resources.PaymentMethod</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td class="number">@string.Join(",",item.Allocations.Select(x => x.SalesOrder.Id.ToString()))</td>
            <td class="date">@Html.DisplayFor(x => item.Date)</td>
            <td class="number">@Html.DisplayFor(x => item.Serial)</td>
            <td class="date">@Html.DisplayFor(x => item.CashSession.Id)</td>
            <td class="text">@Html.DisplayFor(x => item.Customer.Name)</td>
            <td class="date">@item.PaymentType.GetDisplayName()</td>
            <td class="text">@Html.DisplayFor(x => item.Amount)</td>
												<td class="number">@((item.Allocations.Sum(y => (decimal?)y.Amount)??0).ToString("c"))</td>
												<td class="number">@((item.Allocations.Sum(y => (decimal?)y.Change)??0).ToString("c"))</td>
            <td class="number">@Html.DisplayFor(x => item.Balance)</td>
            <td class="center nowrap stretch">@item.Method.GetDisplayName()</td>
        </tr>
    }
    <tr>
        <td class="right" colspan="4"><b>@Resources.Total</b></td>
        <td class="number"><b>@(Model.Sum(x => x.Balance + x.Allocations.Sum(y => (decimal?)y.Amount) ?? 0).ToString("c"))</b></td>
        <td></td>
    </tr>

    @foreach (var item in Model.GroupBy(x => x.Method))
    {
        <tr>
            <td class="right" colspan="4"><i>@item.Key.GetDisplayName()</i></td>
            <td class="number"><i>@((item.Sum(y => y.Balance + y.Allocations.Sum(x => (decimal?)x.Amount))??0).ToString("c"))</i></td>
            <td></td>
        </tr>
    }


</table>

@if (Model.Count() > 0)
{
    <div class='pull-right'>
        @Html.ActionLink(Resources.Print, "PrintReceivedPayments", new
   {
       start = Model.Min(x => x.Date),
       end = Model.Max(x => x.Date),
       store = WebConfig.Store.Id
   }, new { @class = "button icon print", target = "_blank" })
    </div>
}
<div class="clearfix"></div>

