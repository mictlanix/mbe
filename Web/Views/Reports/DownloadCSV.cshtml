@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model DateRange

<h2>@ViewBag.Title</h2>

<div id='master-section'>
    @using (Html.BeginForm("DownloadCSV", "Reports", FormMethod.Post, new { id = "csvForm" }))
    {
        <div class="form-group">
            <div class="row">
                <div class="col-sm-12">
                    <div class="col-sm-2">
                        @Html.EditorFor(x => x.StartDate)
                    </div>
                    <div class="col-sm-2">
                        @Html.EditorFor(x => x.EndDate)
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="row">
                <div class="col-sm-2">
                    <button type="submit" name="action" value="purchases" class="btn btn-default btn-block">@Resources.Purchases</button>
                </div>
                <div class="col-sm-2">
                    <button type="submit" name="action" value="sales" class="btn btn-default btn-block">@Resources.Sales</button>
                </div>
                @*<div class="col-sm-2">
                    <button type="submit" name="action" value="payments" class="btn btn-default btn-block">@Resources.Payments</button>
                </div>*@
            </div>
        </div>
    }
</div>
<style type='text/css'>
    ul.token-input-list {
        width: 100%;
    }
</style>
<script type="text/javascript"></script>
