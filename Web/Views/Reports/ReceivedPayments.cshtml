@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model ReceivedPaymentsFilter

@{
				ViewBag.Title = Resources.ReceivedPayments;
				var CurrentUser = Html.CurrentUser() ?? new User();
				var Privilege = Html.GetPrivilege(CurrentUser, SystemObjects.ReceivedPaymentsAdvancedSearchFilter);
				var Privilege2 = Html.GetPrivilege(CurrentUser, SystemObjects.ReceivedPayments);
}

<h2>@Resources.ReceivedPayments</h2>

<div id="master-section">
				@using (Ajax.BeginForm(new AjaxOptions { UpdateTargetId = "search-results", LoadingElementId = "activity-indicator", OnBegin = "onSearchBegin" }))
				{
								<div class="row">
												<div class="col-sm-2">
																@Html.EditorFor(x => x.StartDate)
												</div>
												<div class="col-sm-2">
																@Html.EditorFor(x => x.EndDate)
												</div>
												<div class="col-sm-2">
																@Html.EditorFor(x => x.OnlyAppliedPayments)
												</div>
												@if (Privilege.AllowRead) {
												<div class="col-sm-3">
																@Html.EditorFor(x => x.StoreId)
												</div>
												}
												<div class="col-sm-1">
																<button class="btn btn-primary btn-block" type="submit">
																				<span class="glyphicon glyphicon-refresh"></span>
																</button>
												</div>
								</div>
				}
</div>
<div id="activity-indicator">
				<img alt="@Resources.Loading" src="@Url.Content("~/Content/images/loading-bar.gif")" />
</div>
<div id="search-results">
</div>
<style type="text/css">
				ul.token-input-list {
								width: 100%;
				}
</style>