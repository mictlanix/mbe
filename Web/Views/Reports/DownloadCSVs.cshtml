@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model DateRange

<h2>@ViewBag.Title</h2>

<div id='master-section'>
				<div class="row">
								@using (Html.BeginForm("SalesCsv", "Reports", FormMethod.Post, new { id = "csvForm" }))
								{
												<div class="row">
																<div class="col-sm-7">
																				<div class="col-sm-2">
																								@Html.EditorFor(x => x.StartDate)
																				</div>
																				<div class="col-sm-2">
																								@Html.EditorFor(x => x.EndDate)
																				</div>
																</div>
												</div>
												<div id='activity-indicator'>
																<img alt='@Resources.Loading' src='@Url.Content("~/Content/images/loading-bar.gif")' />
												</div>
												<div class="row">
																<div class="col-sm-3">
																				<button type="submit" class="csv">@Resources.Sales</button>
																</div>
																<div class="col-sm-3">
																				<button type="submit" class="csv">@Resources.Payments</button>
																</div>
																<div class="col-sm-3">
																				<button type="submit" class="csv">@Resources.Purchases</button>
																</div>
												</div>
								}
				</div>
</div>
<style type='text/css'>
				ul.token-input-list {
								width: 100%;
				}
</style>
<script type="text/javascript">
				function setType(type) {
								document.getElementById("type").value = type;
				}
</script>
