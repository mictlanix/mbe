@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@using System.Linq
@model StoreMovementsSummaryViewModel

<div class="row">
				<div class="col-xs-12">
								<h3>@Resources.StoreMovementsSummary</h3>

								@{
												var groups = Model.Payments.GroupBy(x => x.Method, x => x, (key, g) => new { Method = key, Amounts = g.ToList() }).ToList();
												string zeros = "00000000";
								}
								<table width="50%" class='debts'>
												<thead>
																<tr class="scrollable-header">
																				<th width="15%"></th>
																				<th width="10%">@Resources.PaymentMethod</th>
																				<th width="10%">@Resources.Total</th>
																				<th width="10%">@Resources.Paid</th>
																</tr>
												</thead>
												<tbody>
																<tr>
																				<td colspan="4">@Resources.SalesOrders</td>
																</tr>
																<tr>
																				<td></td>
																				<td>@Resources.Immediate</td>
																				<td>@((Model.SalesOrder.Where(x => x.Terms == 0).Sum(y => (decimal?)y.Total)??0).ToString("c"))</td>
																				<td>@((Model.SalesOrder.Where(x => x.Terms == 0).Sum(y => (decimal?)y.AmountPaid)??0).ToString("c"))</td>
																</tr>
																<tr>
																				<td></td>
																				<td>@Resources.NetD</td>
																				<td>@((Model.SalesOrder.Where(x => x.Terms == 1).Sum(y => (decimal?)y.Total)??0).ToString("c"))</td>
																				<td>@((Model.SalesOrder.Where(x => x.Terms == 1).Sum(y => (decimal?)y.AmountPaid)??0).ToString("c"))</td>
																</tr>
																<tr>
																				<td colspan="4">@Resources.ReceivedPayments</td>
																</tr>
																@foreach (var item in groups)
																{
																				<tr>
																								<td></td>
																								<td>@item.Method.GetDisplayName()</td>
																								<td>@((item.Amounts.Sum(x => x.Amount - x.Allocations.Sum(y => (decimal ?)y.Change) ?? 0m)).ToString("c"))</td>
																								<td></td>
																				</tr>
																}
																<tr>
																				<td colspan="4">@Resources.Expenses</td>
																</tr>
																<tr>
																				<td></td>
																				<td>@Resources.Cash</td>
																				<td>@Model.Expenses.Sum(x => x.Total).ToString("c")</td>

																</tr>
												</tbody>
								</table>

								<h3>@Resources.SalesOrders</h3>

								<table class='debts'>
												<thead>
																<tr>
																				<th>@Resources.SalesOrder</th>
																				<th>@Resources.Date</th>
																				<th>@Resources.Serial</th>
																				<th>@Resources.SalesPerson</th>
																				<th>@Resources.PaymentTerms</th>
																				<th>@Resources.FiscalDocument</th>
																				<th>@Resources.DueDate</th>
																				<th>@Resources.Customer</th>
																				<th>@Resources.Total</th>
																				<th>@Resources.Refunds</th>
																				<th>@Resources.CustomerRefund</th>
																				<th>@Resources.Paid</th>
																</tr>
												</thead>
												<tbody>
																@foreach (var item in Model.SalesOrder)
																{
																				<tr>
																								<td class="text-center">
																												@Html.ActionLink((string)item.SalesOrder.ToString(zeros), "Print", "Payments", new { id = item.SalesOrder }, new { title = Resources.Details, target = "_blank" })
																								</td>
																								<td class="col-sm-1 data">@item.Date.ToString("yyyy-MM-dd")</td>
																								<td class="col-sm-1 data text-center">@item.Serial.ToString(zeros)</td>
																								<td class="col-sm-1 data">@(item.SalesPerson.ToUpper())</td>
																								@*<td class="col-sm-1 data text-center">@(((PaymentTerms)item.Terms).GetDisplayName())</td>*@
																								<td class="col-sm-1 data text-center">@((item.Terms))</td>
																								<td class="col-sm-1 data text-center">@item.Invoices</td>
																								<td class="col-sm-1 data text-center">@(item.Terms == 1 ? item.DueDate.ToString("yyyy-MM-dd"):string.Empty)</td>
																								<td class="col-sm-1 data text-center">@item.Customer</td>
																								<td class="col-sm-1 data text-center">@item.TotalEx.ToString("c")</td>
																								<td class="col-sm-1 data text-center">
																												@if (item.RefundIDs != null)
																												{
																																var ids = item.RefundIDs.Split(',');
																																foreach (var id in ids)
																																{
																																				@Html.ActionLink((string)Int32.Parse(id).ToString(zeros), "View", "CustomerRefunds",
																																																											new { id = id }, new { title = Resources.Details, target = "_blank" }) <br />
																																}
																												}
																								</td>
																								<td class="col-sm-1 data text-center">@(item.Refund != null?item.Refund.ToString("c"):string.Empty)</td>
																								<td class="col-sm-1 data text-center">@(item.Paid == true ? Resources.Paid : item.AmountPaid.ToString("c"))</td>
																				</tr>
																}
												</tbody>
								</table>

								<h3>@Resources.Payments</h3>

								<table class='debts'>
												<thead>
																<tr>
																				<th class='center'>@Resources.Payment</th>
																				<th class='center'>@Resources.Date</th>
																				<th class='center'>@Resources.CashSession</th>
																				<th class='center'>@Resources.Serial</th>
																				<th class='center'>@Resources.SalesPerson</th>
																				<th class='center'>@Resources.Customer</th>
																				<th class='center'>@Resources.PaymentMethod</th>
																				<th class='center'>@Resources.PaymentType</th>
																				<th class='center'>@Resources.Amount</th>
																				<th class='center'>@Resources.Balance</th>
																				<th class='center'>@Resources.Change</th>
																				<th class='center'>@Resources.SalesOrders</th>
																</tr>
												</thead>
												<tbody>
																@foreach (var item in Model.Payments.OrderBy(x => x.Method))
																{


																				<tr>
																								<td class="data date text-center">
																												@Html.DisplayFor(x => item.Id)
																								</td>
																								<td class="col-sm-1 data">@Html.DisplayFor(x => item.Date)</td>
																								<td class="col-sm-1 data">@Html.DisplayFor(x => item.CashSession.Id)</td>
																								<td class="col-sm-1 data text-center">@item.Serial.ToString()</td>
																								<td class="col-sm-1 data">@Html.DisplayFor(x => item.Creator.Nickname)</td>
																								<td class="col-sm-1 data text-center">@item.Customer.Name</td>
																								<td class="col-sm-1 data text-center">@item.Method.GetDisplayName()</td>
																								<td class="col-sm-1 data text-center"></td>
																								<td class="col-sm-1 data text-center">@((item.Amount).ToString("c"))</td>
																								<td class="col-sm-1 data text-center">@((item.Allocations.Sum(x => (decimal?)x.Amount)??0).ToString("c"))</td>
																								<td class="col-sm-1 data text-center">@((item.Allocations.Sum(x => (decimal?)x.Change)??0).ToString("c"))</td>
																								<td class="col-sm-1 data text-center">
																												@if (item.Allocations.Count() > 0)
																												{
																																foreach (var id in item.Allocations)
																																{
																																				@Html.ActionLink((string)id.SalesOrder.Id.ToString(), "Print", "Payments",
new { id = id.SalesOrder.Id }, new { title = Resources.Details, target = "_blank" }) <br />
																																}
																												}
																								</td>
																				</tr>
																}
												</tbody>
								</table>

								<h3>@Resources.Expenses</h3>

								<table class="debts">
												<thead>
																<tr class="scrollable-header">
																				<th class="col-sm-1 ">@Resources.Payment</th>
																				<th class="col-sm-1 ">@Resources.Date</th>
																				<th class="col-sm-1 ">@Resources.SalesPerson</th>
																				<th class="col-sm-1 ">@Resources.Total</th>
																				<th class="col-sm-1 ">@Resources.Comment</th>
																				<th class="col-sm-1 ">@Resources.Concepts</th>
																</tr>
												</thead>
												<tbody>
																@foreach (var item in Model.Expenses)
																{
																				<tr>
																								<td class="col-sm-1 data date text-center">
																												@Html.ActionLink(item.Id.ToString(), "View", "ExpenseVoucher", new { id = item.Id }, new { title = Resources.Details, target = "_blank" })
																								</td>
																								<td class="col-sm-1 data">@Html.DisplayFor(x => item.Date)</td>
																								<td class="col-sm-1 data">@Html.DisplayFor(x => item.CashSession.Cashier.Nickname)</td>
																								<td class="col-sm-1 data text-center">@Html.DisplayFor(x => item.Total)</td>
																								<td class="col-sm-1 data text-center">@Html.DisplayFor(x => item.Comment)</td>
																								<td class="col-sm-1 data text-center">
																												@Html.Raw(string.Join("<br/>", item.Details.Select(x => x.Expense.Name)))
																								</td>
																								<td class="col-sm-1 data text-center">
																												@Html.Raw(string.Join("<br/>", item.Details.Select(x => x.Comment)))
																								</td>
																				</tr>
																}
												</tbody>
								</table>
				</div>
<div class="clearfix"></div>
</div>