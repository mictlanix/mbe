@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model CommissionTicketViewModel

@{
    var CurrentUser = Html.CurrentUser() ?? new User();
    var Privilege = CurrentUser.GetPrivilege (SystemObjects.SalesOrders);
}


<table class="debts">
    <thead>
        <tr>
            <th>@Resources.Labels</th>
												<th>Comisi&oacute;n</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.Details.GroupBy(i => new { i.Label })
                .Select(g => new { Family = g.Key, Details = g.ToList() })) {
            <tr>
                <td>@(item.Family.Label == null ? "** SIN ETIQUETAS **": item.Family.Label)</td>
                <td>@(item.Details.Where(x => x.Payable && x.PaidStatus).Sum(x => (decimal)x.Commission).ToString("c"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td class="total">@Resources.Total</td>
            <td class="total">@(Model.Details.Where(x => x.Payable && x.PaidStatus )
                                    .Sum(x => (decimal)(x.Commission)).ToString("c"))</td>
        </tr>
    </tfoot>
</table>

