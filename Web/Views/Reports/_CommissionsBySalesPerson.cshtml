<script>
				$('a.editable').editable({

        success: function (response, newValue) {
												$.post('@Url.Action("CommissionsBySalesPerson",
               new
               {
                   employee = Model.CommissionAgent == null?
                    (int?)null : Model.CommissionAgent.Id
                   ,
                   StartDate = Model.DateRange.StartDate,
                   EndDate = Model.DateRange.EndDate
               })', 
																function (respuesta) {
                    $('#search-results').html(respuesta); 
                    $("#activity-indicator").hide();
																}
												).fail(function (xhr, status, error) {
																$('#search-results').html('Error: ' + error);
												});

								},
								error: function (response, newValue) {
												//console.log(response)
												//console.log(newValue)
												//if (response.status === 400) {
												//				console.log("vamos bien...")
            //}
            return response.responseText;
								},
								validate: function (value) {
												if (value < 0) {
																console.log(value)
												}
								},
								display: function (value, response) {
												console.log(value)
												console.log(response)
												if (typeof response === 'undefined')
																return;

												if (Array.isArray(response)) {
																var arr = $.grep(response, function (o) {
																				return o.value == value;
																});
																if (arr.length != 0) {
																				$(this).html(arr[0].text);
																}
												} else {
																$(this).html(response.value);
												}
								}
				});
</script>