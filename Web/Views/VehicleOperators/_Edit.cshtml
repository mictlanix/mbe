@using Mictlanix.BE
@using Mictlanix.BE.Model

@model VehicleOperator

<div class='modal-header'>
	<button type='button' class='close' data-dismiss='modal'>&times;</button>
	<h3>@Resources.VehicleOperator</h3>
</div>
<div class='modal-body'>
	@using (Ajax.BeginForm(null, null, new AjaxOptions { HttpMethod = "POST",
		UpdateTargetId = "vehicle-operator-modal-content" }
							, new { @class = "modal-form" }))
	{

		@Html.AntiForgeryToken()
		@Html.ValidationSummary(true)
		<div class="form-horizontal">
			@Html.LabelFor(model => model.IssueLicenceDate, htmlAttributes: new { @class = "control-label col-md-2" })
			<div class="col-xs-4">
				@Html.EditorFor(model => model.IssueLicenceDate, new { htmlAttributes = new { @class = "form-control" } })
				@Html.ValidationMessageFor(model => model.IssueLicenceDate, "", new { @class = "text-danger" })
			</div>
		</div>

		<div class="form-horizontal">
			@Html.LabelFor(model => model.ExpirationLicenceDate, htmlAttributes: new { @class = "control-label col-md-2" })
			<div class="col-xs-4">
				@Html.EditorFor(model => model.ExpirationLicenceDate, new { htmlAttributes = new { @class = "form-control" } })
				@Html.ValidationMessageFor(model => model.ExpirationLicenceDate, "", new { @class = "text-danger" })
			</div>
		</div>
	}
</div>
<div class="clear"></div>
<div class='modal-footer'>
	<button type='button' class='btn btn-default' data-dismiss='modal'>@Resources.Discard</button>
	<button type='submit' class='btn btn-primary' onclick='$("#vehicle-operator-modal form").submit();'>@Resources.Save</button>
</div>
