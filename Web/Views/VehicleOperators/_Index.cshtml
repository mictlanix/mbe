@using Mictlanix.BE.Model
@using Mictlanix.BE
@using Mictlanix.BE.Web.Models
@using Mictlanix.BE.Web.Helpers

@model Search<VehicleOperator>

@{
	var CurrentUser = Html.CurrentUser() ?? new User();
	var Privilege = Html.GetPrivilege(CurrentUser, SystemObjects.VehicleOperators);

	ViewBag.Title = Resources.VehicleOperators;
}

<table class="table-condensed">
	<thead>
		<tr>
			<th>@Resources.Id</th>
			<th>@Resources.Name</th>
			<th>@Resources.DriverLicenseNumber</th>
			<th>@Resources.Type</th>
			<th>@Resources.IssuingLocation</th>
			<th>@Resources.CurrentValid</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.Results)
		{
			<tr>
				<td>@Html.DisplayFor(x => item.Id)</td>
				<td>@Html.DisplayFor(x => item.Operator.Name)</td>
				<td class="text-center">@Html.DisplayFor(x => item.LicenseDriverNumber)</td>
				<td class="text-center">@Html.DisplayFor(x => item.LicenseType)</td>
				<td class="text-center">@Html.DisplayFor(x => item.IssuingLocation)</td>
				<td class="text-center">@Html.DisplayFor(x => item.IsLicenceCurrentValid)</td>
				<td class="action-buttons">
					@if (Privilege.AllowUpdate)
					{
						@Html.ActionLink(" ", "Edit", new { id = item.Id },
					   new { @class = "button icon edit icon-only open-modal",
						   title = Resources.Edit, data_modal_id = "vehicle-operator-modal" })
					}
					@if (Privilege.AllowDelete)
					{
						@Html.ActionLink(" ", "Delete", new { id = item.Id },
					   new { @class = "button icon delete icon-only open-modal",
						   title = Resources.Delete, data_modal_id = "vehicle-operator-modal" })
					}
				</td>
			</tr>
		}
	</tbody>
	<tfoot></tfoot>
</table>

<div class="buttons right">
	<label class='button left'>@Model.ToString()</label>@if (Model.HasPrev)
	{<a class='button middle icon prev icon-only paging' title='@Resources.PrevPage' href='javascript:void(0)'></a>}@if (Model.HasNext)
	{<a class='button right icon next icon-only paging' title='@Resources.NextPage' href='javascript:void(0)'></a>}
</div>


<script type="text/javascript">
    bindModal('.open-modal');

    $('a.paging').click(function (e) {
        var offset=@Model.Offset;

        if($(this).hasClass('next')) {
            offset+=@Model.Limit;
        } else {
            offset-=@Model.Limit;
        }

        e.preventDefault();
        $('#activity-indicator').show();
        $('#search-results').hide();

        $.post('@Url.Action("Index")', { Pattern: '@Model.Pattern', Offset: offset, Limit: @Model.Limit }, function(data) {
            $('#search-results').html(data);
            $('#search-results').show();
            $('#activity-indicator').hide();
        });
    });

</script>