@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models

@model Search<User>
@{
				ViewBag.Title = Resources.Title_Users;
				var CurrentUser = Html.CurrentUser() ?? new User();
}
<div class="page-header">
				<h1>@Resources.DisplayName_Users</h1>
</div>
<table>
				<tr>
								<th>
												@Resources.UserName
								</th>
								<th>
												@Resources.Employee
								</th>
								<th>
												@Resources.Email
								</th>
								<th>
												@Resources.Store
								</th>
								<th>
												@Resources.PointOfSale
								</th>
								<th>
												@Resources.Warehouse
								</th>
								<th>
												@Resources.Administrator
								</th>
								<th></th>
				</tr>
				@foreach (var item in Model.Results)
				{
								<tr>
												<td>
																@Html.DisplayFor(x => item.UserName)
												</td>
												<td>
																@Html.DisplayFor(x => item.Employee.Name)
												</td>
												<td class="center">
																@Html.DisplayFor(x => item.Email)
												</td>
												<td class="center">
																@Html.DisplayFor(x => item.UserSettings.Store.Name)
												</td>
												<td class="center">
																@Html.DisplayFor(x => item.UserSettings.PointOfSale.Name)
												</td>
												<td class="center">
																@Html.DisplayFor(x => item.UserSettings.PointOfSale.Warehouse.Name)
												</td>
												<td class="center">
																@Html.DisplayFor(x => item.IsAdministrator)
												</td>
												<td class="actions">
																@if (CurrentUser.IsAdministrator)
																{
																				@Html.ActionLink(" ", "Edit", new { id = item.UserName }, new { @class = "button icon edit icon-only", @title = Resources.Edit })
																				@Html.ActionLink(" ", "Details", new { id = item.UserName }, new { @class = "button icon view icon-only", @title = Resources.Details })
																				@Html.ActionLink(" ", "Delete", new { id = item.UserName }, new { @class = "button icon delete icon-only", @title = Resources.Delete })
																}
												</td>
								</tr>
				}
</table>

<div class='buttons right'>
				<label class='button left'>@Model.ToString()</label>@if (Model.HasPrev)
				{<a class='button middle icon prev icon-only paging' title='@Resources.PrevPage' href='javascript:void(0)'></a>}@if (Model.HasNext)
				{<a class='button right icon next icon-only paging' title='@Resources.NextPage' href='javascript:void(0)'></a>}
</div>
<script type='text/javascript'>
$('[data-toggle="tooltip"]').tooltip();
$('a.paging').click(function (e) {
	var offset=@Model.Offset;

	if($(this).hasClass('next')) {
		offset+=@Model.Limit;
	} else {
		offset-=@Model.Limit;
	}

	e.preventDefault();
	$('#activity-indicator').show();
	$('#search-results').hide();

	$.post('@Url.Action("Index")', { Pattern: '@Model.Pattern', Offset: offset, Limit: @Model.Limit }, function(data) {
		$('#search-results').html(data);
		$('#search-results').show();
		$('#activity-indicator').hide();
	});
});
</script>
