@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model IncidenceSearch

<table class="table-hover">
    <tr>
        <th>@Resources.IncidenceId</th>
        <th class="date">@Resources.ModificationTime</th>
        <th>@Resources.Source</th>
        <th>@Resources.Reference</th>
        <th>@Resources.Updater</th>
        <th>@Resources.Comment</th>
        <th></th>
    </tr>
@foreach (var item in Model.Results) {
    var content = IncidenceContent.Parse(item);
    <tr>
        <td class="number">@Html.DisplayFor(x => item.Id)</td>
        <td class="date">@Html.DisplayFor(x => item.ModificationTime)</td>
        <td>@item.SourceType.GetDisplayName()</td>
        <td class="number">@Html.DisplayFor(x => item.Reference)</td>
        <td>@item.Updater.Name</td>
        <td>
            @if (content.IsPostChangeSnapshot) {
                <span class="glyphicon glyphicon-warning-sign text-warning" data-toggle="tooltip" title="@Resources.IncidencePostChangeSnapshot"></span>
            }
            @(string.IsNullOrEmpty(item.Comment) && !content.IsStructured ? content.Text : item.Comment)
        </td>
        <td class="actions">
            @Html.ActionLink(" ", "Details", new { id = item.Id }, new { @class = "button icon view icon-only open-modal", title = Resources.Details, data_modal_id = "incidence-modal" })
        </td>
    </tr>
}
</table>
<div class="buttons right">
	<label class="button left">@Model.ToString()</label>@if (Model.HasPrev) {<a class="button middle icon prev icon-only paging" title="@Resources.PrevPage" href="javascript:void(0)"></a>}@if (Model.HasNext) {<a class="button right icon next icon-only paging" title="@Resources.NextPage" href="javascript:void(0)"></a>}
</div>
<script type="text/javascript">
$('[data-toggle="tooltip"]').tooltip();
bindModal('.open-modal');
$('a.paging').click(function (e) {
	var offset = @Model.Offset;

	if ($(this).hasClass('next')) {
		offset += @Model.Limit;
	} else {
		offset -= @Model.Limit;
	}

	e.preventDefault();
	$('#Offset').val(offset);
	$('#activity-indicator').show();
	$('#search-results').hide();

	// Re-send the filters, not just the page.
	$.post('@Url.Action("Index")', $('#incidence-search').serialize(), function (data) {
		$('#search-results').html(data);
		$('#search-results').show();
		$('#activity-indicator').hide();
	});
});
</script>
