@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model Search<CommissionProduct>
@{
    ViewBag.Title = Resources.Commissions + " " + Resources.Product;
    var CurrentUser = Html.CurrentUser() ?? new User();
    var Privilege = CurrentUser.GetPrivilege (SystemObjects.DeliveryItineraries);
}
<div class="page-header">
    <div class="pull-right col-xs-6">
		<div class="row">
								<div class="col-xs-4 text-right">
												@if (Privilege.AllowCreate)
												{
																using (Html.BeginForm("New", "DeliveryItineraries", null,
																				FormMethod.Post, new { @class = "modal-form" }))
																{
																				<button type="submit" class="btn btn-primary">
																								<span class="glyphicon glyphicon-plus"></span>
																				</button>
																}
												}
								</div>
	        <div class="col-xs-8 input-group">
			@using (Ajax.BeginForm(new AjaxOptions { UpdateTargetId = "search-results", LoadingElementId = "activity-indicator", OnBegin = "onSearchBegin" })) {
			    @Html.HiddenFor(x => x.Offset)
			    @Html.HiddenFor(x => x.Limit)
			    <div class="input-group">
					<input id="Pattern" name="Pattern" type="text" class="form-control" placeholder="@Resources.SearchFor">
					<span class="input-group-btn">
						<button class="btn btn-default" type="submit">
							<span class="glyphicon glyphicon-search"></span>
						</button>
					</span>
				</div>
			}
	        </div>
	    </div>
	</div>
				<h1>@Resources.Commissions @Resources.Product</h1>
</div>
<div id="activity-indicator">
    <img alt="@Resources.Loading" src="@Url.Content("~/Content/images/loading-bar.gif")" />
</div>
@*<div id="search-results" data-url="@Url.Action("Index")">
    @Html.Partial("_Index", Model)
</div>*@
<table>

@foreach(var item in Model.Results) {
				<tr>
								<td>@item.Product.Id</td>
								<td>@item.Product.Code</td>
								<td>@item.Product.Name</td>
								<td>@item.Commission.Name</td>
								<td>@item.Commission.CommissionRate</td>
				</tr>
}
</table>

<script type="text/javascript">
				$('a.to-validate').editable({
								success: function() {
												var self = $(this);
												var value = self.data('value');
																$.ajax({
																				type: "POST",
																				url: self.data('url')
																}).done(function (data) {
																				var item = $('#id\\:' + value);
																				item.hide().replaceWith(data).fadeIn(3000);
																});
								}
				});
</script>