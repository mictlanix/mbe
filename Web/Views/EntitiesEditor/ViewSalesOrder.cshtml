@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@model SalesOrder

@{
    ViewBag.Title = Resources.SalesOrder;

				var isEditable = Model.Date.Date 
}

<h2>@Resources.SalesOrder</h2>

<div id="master-section">
				@Resources.SalesOrder  @Html.ActionLink(Model.Id.ToString(), "Pdf","POS", new {id = Model.Id}, new {target = "_blank"})
				@Resources.Credit @Html.DisplayFor(x => Model.IsCredit)

				@Model.DeliveryMode.GetDisplayName()
				@using (Html.BeginForm("EditPayment", "Correction", FormMethod.Post, null))
				{
								<button type="submit" style="display:inline">Restaurar método de envío</button>
				}

</div>
<div id="details-section">
				<div id="payments-container">
								@Resources.Payments
								<ul id="items" class="list-items">
												@foreach (var item in Model.Payments)
												{
																<li>
																				@Html.DisplayFor(x => item.Amount) @item.Payment.Method.GetDisplayName()
																				@using (Html.BeginForm("EditPayment", "Correction", FormMethod.Post, null))
																				{
																								<button type="submit">Reabrir pago para el vendedor</button>
																				}
																</li>
												}
								</ul>
				</div>
				<div id="deliveries-container">
								@Resources.DeliveryOrders
								<ul id="items" class="list-items">
												@foreach (var item in Model.GetDeliveryOrders())
												{
																<li>
																				@Html.DisplayFor(x => item.Id)
																				@using (Html.BeginForm("EditPayment", "Correction", FormMethod.Post, null))
																				{
																								<button type="submit">Reabrir orden de envío para el vendedor</button>
																				}
																</li>
												}
								</ul>
				</div>
</div>
<div class='clearfix'></div>
