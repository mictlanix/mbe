@using Mictlanix.BE
@using Mictlanix.BE.Model
@model PurchaseRequest

<div class="form-group">
	<div class="col-xs-12">@Html.LabelFor(x => x.ProductId) @Html.EditorFor(x => x.ProductId) @Html.ValidationMessageFor(model => model.ProductId)</div>
	<div class="col-xs-4 field-required">@Html.LabelFor(x => x.Quantity) @Html.EditorFor(x => x.Quantity) @Html.ValidationMessageFor(model => model.Quantity)</div>
</div>
<div class="form-group">
	<div class="col-xs-12 field-required">@Html.LabelFor(x => x.WarehouseId) @Html.EditorFor(x => x.WarehouseId) @Html.ValidationMessageFor(model => model.WarehouseId)</div>
</div>
<div class="form-group">
	<div class="col-xs-12">@Html.LabelFor(x => x.Comment) @Html.EditorFor(x => x.Comment)</div>
	<div class="col-xs-12">@Html.LabelFor(x => x.CustomerId) @Html.EditorFor(x => x.CustomerId) @Html.ValidationMessageFor(model => model.CustomerId)</div>
</div>
<style type="text/css">
	ul.token-input-list {
		width: 100%;
	}
</style>

@if (Model.Product != null)
{
	<script type='text/javascript'>
		$(document).ready(function(){
			$("#ProductId").tokenInput("add", { id: "@Model.ProductId", name: "@Html.Raw(Model.Product.Name)"});
		})
	</script>
}
@if (Model.Warehouse != null)
{
	<script type='text/javascript'>
		$(document).ready(function () {
		    $("#WarehouseId").tokenInput("add", { id: "@Model.WarehouseId", name: "@Html.Raw(Model.Warehouse.Name)"});
		})
	</script>
}