@using Mictlanix.BE.Model
@model int?

@{
				var field = ViewData.TemplateInfo.HtmlFieldPrefix;
				var cd = Mictlanix.BE.Web.Models.MBEQueryable.IQCashDrawers.SingleOrDefault(x => x.Id == Model);
				var str = cd==null?0:cd.Store.Id;
}

