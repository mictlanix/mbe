@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@model CustomerPayment

<div class="form-group">
    <div class="col-xs-6 field-required" style="font-size:3em;">@Html.LabelFor(x => x.Amount) @Html.DisplayFor(x => x.Amount) @Html.ValidationMessageFor(x => x.Amount)</div>
</div>
<div class="form-group">
				<input id="Amount" name="Amount" style="font-size:3em; height:1.5em;" class="form-control text-right" type="text" autocomplete="off" placeholder="@Model.Amount">
</div>
<div class="form-group">
				<div class="col-xs-12 field-required">
								@Html.LabelFor(x => x.Method)
								<select name="Method">
												@foreach (var method in WebConfig.CashierPaymentOptions)
												{
																<option value="@method" @(method == Model.Method ? "Selected":"") >@method.GetDisplayName()</option>
												}
								</select>
								@Html.ValidationMessageFor(x => x.Method)
				</div>
</div>
<div class="form-group">
	<div class="col-xs-12">
		@Html.LabelFor(x => x.Customer): @(Model.Customer == null ? string.Empty : Model.Customer.Name)
		@* A different customer, only for a payment with no allocations. Not CustomerSelector:
		   Html.Editor ("customer") would resolve to Model.Customer. *@
		<input type="text" id="customer" name="customer" />
		<script type="text/javascript">
			$("#customer").tokenInput("@Url.Action("GetSuggestions", "Customers")", {
				hintText: "@Resources.ChooseCustomer",
				noResultsText: "@Resources.NoResultsText",
				searchingText: "@Resources.SearchingText",
				queryParam: "pattern",
				minChars: 1,
				tokenLimit: 1
			});
		</script>
	</div>
</div>
<div class="form-group">
    <div class="col-xs-12 field-required">@Html.LabelFor(x => x.Reference)
				@Html.EditorFor(x => x.Reference)
				@Html.ValidationMessageFor(x => x.Reference)</div>
</div>
<div class="form-group">
	<div class="col-xs-12 field-required">
		<label for="reason">@Resources.Comment</label>
		<textarea id="reason" name="reason" class="form-control" rows="2" maxlength="500"></textarea>
	</div>
</div>
<div class="form-group">
				@Html.ValidationSummary()
</div>


<style type="text/css">
ul.token-input-list { width: 100%; }
</style>
