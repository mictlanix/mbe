<select type="text" href="#" class="form-control text-box single-line valid" name="@field"></select>
<script>
				$(function () {
								const select = document.getElementsByName('@field')[0];
								var model = "@(Model == null ? string.Empty : Model.ToString())"
								fetch(`/Warehouses/List/${model}`).then(respuest => respuest.json())
												.then(datos => {
																datos.forEach(option => {
																				const element = document.createElement('option');
																				element.value = option.value;
																				element.textContent = option.text;
																				console.log(element)
																				if (option.value == model) {
																								element.selected = true;
																				}
																				select.add(element);
																})
												})
				});
</script>