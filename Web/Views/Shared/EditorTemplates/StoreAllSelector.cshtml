<select type="text" href="#" class="form-control text-box single-line valid" name="@field" id="@field"></select>
<script>
				$(function () {
								const select = document.getElementsByName('@field')[0];
								var model = "@(Model.HasValue ? Model : null)"
								fetch("/Stores/ListAll").then(respuest => respuest.json())
												.then(datos => {
																datos.forEach(option => {
																				const element = document.createElement('option');
																				element.value = option.value;
																				element.textContent = option.text;
																				if (option.value == model) {
																								element.selected = true;
																				}
																				select.appendChild(element);
																});
												})
				});
</script>