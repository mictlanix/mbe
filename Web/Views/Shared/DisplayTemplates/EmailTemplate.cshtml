@model dynamic

<div style="font-family: Arial, sans-serif; color: #333; padding: 20px; border: 1px solid #e0e0e0; background-color: #fafafa;">
  <!-- Encabezado con logo y nombre -->
  <div style="text-align: center; margin-bottom: 25px;">
    <img src="http://mbe.casa-maestra.com.mx/Content/images/logo.png" alt="Logo Casa Maestra" style="height: 90px; margin-bottom: 10px;" />
    <!--<h2 style="color: #2c3e50; margin: 0;">Casa Maestra</h2>-->
    <p style="color: #777; font-size: 14px; margin: 5px 0;">¡Generando calidad de vida para la comunidad!</p>
  </div>

  <!-- Cuerpo del mensaje -->
  <p style="font-size: 15px;">Estimado/a <strong>Cliente</strong>,</p>
  <p style="font-size: 15px; line-height: 1.6;">
    Le compartimos el archivo solicitado.  
    Nuestro equipo está a su disposición para resolver cualquier duda o comentario.
  </p>

  <!-- Bloque destacado -->
  <div style="background-color: #2c3e50; color: #fff; padding: 15px; margin: 20px 0; border-radius: 5px; text-align: center;">
    <p style="margin: 0; font-size: 16px;">📞 Atención personalizada: <strong>55-1234-5678</strong></p>
    <p style="margin: 0; font-size: 14px;">✉️ ventas@casa-maestra.com.mx</p>
  </div>

  <!-- Pie de página -->
  <div style="margin-top: 30px; font-size: 12px; color: #777; border-top: 1px solid #ccc; padding-top: 10px; text-align: center;">
    <p>Atentamente,</p>
    <p><strong>Equipo de Ventas</strong><br/>
    Casa Maestra<br/>
    <a href="https://casa-maestra.com.mx/" target="_blank" style="color: #2980b9; text-decoration: none;">casa-maestra.com.mx</a></p>
  </div>
</div>
