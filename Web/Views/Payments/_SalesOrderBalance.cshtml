@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@model SalesOrder

<ul class='labeled-frames pull-right'>
				<li>
								<span class='caption'>@Resources.Total</span>
								<span class='value'>@Html.DisplayFor(x => x.TotalEx) @WebConfig.BaseCurrency</span>
								@if (Model.Currency != WebConfig.BaseCurrency)
								{
												<span class='value'>@Html.DisplayFor(x => x.Total) @Html.DisplayFor(x => x.Currency)</span>
								}
				</li>
				@if (Model.CustomerRefunds.Sum(x => x.Total) > 0.0m)
				{
								<li>
												<span class='caption'>@Resources.Refund</span>
												<span class='value'>@Model.CustomerRefunds.Sum(y => y.Total).ToString("c") @WebConfig.BaseCurrency</span>
												@if (Model.Currency != WebConfig.BaseCurrency)
												{
																<span class='value'>@Html.DisplayFor(x => x.Currency) @Html.DisplayFor(x => x.Currency)</span>
												}
								</li>
				}
				<li>
								<span class='caption'>@Resources.Paid</span>
								<span class='value'>@Html.DisplayFor(x => x.Paid) @WebConfig.BaseCurrency</span>
				</li>
				@if (Model.Currency != WebConfig.BaseCurrency)
				{

					@Html.DisplayFor(x => x.Total);

				@Html.DisplayFor(x => x.Currency);

				}

				@if (Model.CreditNotesAmount > 0.0m)
				{
								<li>
												<span class="caption">@Resources.ExtraFees</span>
												<span class="value">@Html.DisplayFor(x => x.ExtraFee) @WebConfig.BaseCurrency</span>
								</li>
				}
				@if (Model.ExtraFee > 0.0m)
				{


				@Resources.ExtraFees;
				 @Html.DisplayFor(x => x.ExtraFee);
					@WebConfig.BaseCurrency;

				}

				@if (Model.Balance > 0.0m)
				{
								<li>
												<span class="caption">@Resources.Balance</span>
												<span class="value">@Html.DisplayFor(x => x.Balance) @WebConfig.BaseCurrency</span>
								</li>
				}
				<li>
								<span class='caption'>@Resources.Change</span>
								<span class='value'>@Html.DisplayFor(x => x.Change) @WebConfig.BaseCurrency</span>
				</li>
</ul>

<div class='clearfix'></div>
<div class='order-actions'>
	<div class='order-actions-left'>
		@Html.ActionLink(Resources.BackToList, "Index", new { }, new { @class = "button icon back" })
	</div>
	<div class='order-actions-right'>
		@if (Model.IsPaid || Model.Terms == PaymentTerms.NetD)
		{
			if (Model.DeliveryMode == DeliveryMode.ToBeDefined)
			{
				<button type="submit" class='icon shipping partial_deliveries' value="@DeliveryMode.PartialDeliveries">@Resources.PartialDeliveries</button>
				<button type="submit" class='icon delivery partial_deliveries' value="@DeliveryMode.PickUp">@Resources.PickUp</button>
			}
			else
			{
				if (Model.DeliveryMode == DeliveryMode.PartialDeliveries)
				{
					<button type="submit" id="delivery" class='icon shipping'>@Resources.CreateNew @Resources.DeliveryOrder</button>
				}

				@Html.ActionLink(Resources.SalesReceipt, "Print", new { id = Model.Id },
					new { @class = "button icon print", target = "_blank" })
			}
		}
		@if (Model.Payments.Any(x => !x.IsConfirmed))
		{
			using (Ajax.BeginForm("ConfirmPayment", "Payments", new { id = Model.Id },
				new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "details-order" }))
			{
				<button type="submit" class='icon confirm-payments lock'>@Resources.CompletePayment</button>
			}
		}
	</div>
</div>
<script type="text/javascript">
@if (Model.Balance <= 0.01m) {
    <text>$("#form").hide("slow");</text>
} else {
	<text>
    $("#amount").attr("placeholder", Number(@(Model.BalanceInCashDrawer())))
        $("#form").show("slow");
	</text>
}

		$(function () {
					$('[data-toggle="tooltip"]').tooltip();
		});

				$("#delivery").on("click",function () {
								console.log("working");
								$.post("/DeliveryOrders/New", { value: @Model.Id }, function (data) {
												location.href = data.url;
								}).fail(function (e) {
												DisplayErrorMessage(e.responseText)
								});
				});

								$(".partial_deliveries").on("click",function () {
												console.log("working partials");
												var val = $(this).val();
												console.log(val);
								$.post("/Payments/SetPartialDeliveries", { id: @Model.Id, value: val }, function (data) {
												location.reload();
								}).fail(function (e) {
												DisplayErrorMessage(e.responseText)
								});
				});
</script>
