@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model Search<CustomerPayment>
@{
	ViewBag.Title = Resources.PaymentsEditor;
}
<div class="page-header">
	<div class="pull-right col-xs-5">
	@using (Ajax.BeginForm("Payments", "Payments", new AjaxOptions { UpdateTargetId = "search-results", LoadingElementId = "activity-indicator", OnBegin = "onSearchBegin" })) {
		@Html.HiddenFor(x => x.Offset)
		@Html.HiddenFor(x => x.Limit)
		<div class="input-group">
			<input id="Pattern" name="Pattern" type="text" class="form-control" placeholder="@Resources.SearchFor" value="@Model.Pattern">
			<span class="input-group-btn">
				<button class="btn btn-default" type="submit">
					<span class="glyphicon glyphicon-search"></span>
				</button>
			</span>
		</div>
	}
	</div>
	<h1>@Resources.PaymentsEditor</h1>
</div>
<div id='activity-indicator'>
	<img alt='@Resources.Loading' src='@Url.Content("~/Content/images/loading-bar.gif")' />
</div>
<div id='search-results'>
	@Html.Partial("_Index")
</div>
