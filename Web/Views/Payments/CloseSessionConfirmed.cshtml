@using Mictlanix.BE
@using Mictlanix.BE.Model
@using Mictlanix.BE.Web.Helpers
@using Mictlanix.BE.Web.Models
@model CashCountReport
@*@model MasterDetails<CashSession, MoneyCount>*@

@{
    ViewBag.Title = Resources.Title_CloseSession;
    ViewBag.ShowCloseSession = false;
}

<h2>@Resources.DisplayName_CloseSession</h2>

<fieldset>
    <legend>@Resources.DisplayName_CashSession</legend>

    <div class="display-label">
        @Html.LabelFor(model => model.CashDrawer) :
        @Html.DisplayFor(model => model.CashDrawer.Name)
    </div>
    
    <div class="display-label">
        @Html.LabelFor(model => model.Cashier) :
        @Html.DisplayFor(model => model.Cashier.Name)
    </div>

    <div class="display-label">
        @Html.LabelFor(model => model.Start) :
        @Html.DisplayFor(model => model.Start)
    </div>

    <div class="display-label">
        @Html.LabelFor(model => model.End) :
        @Html.DisplayFor(model => model.End)
    </div>

    <div class="display-label">
        @Html.LabelFor(model => model.StartingCash) :
        @Html.DisplayFor(model => model.StartingCash)
    </div>

    <div class="display-label">
        @Html.LabelFor(model => model.CountedCash) :
        @Html.DisplayFor(model => model.CountedCash)
    </div>
    
</fieldset>

@helper Totals (IEnumerable<MoneyCount> items) {
<table>
    <tr>
        <th>@Resources.PaymentMethod</th>
        <th>@Resources.Amount</th>
    </tr>
@foreach (var item in items) {
    <tr>
        <td class="number">@item.Method.GetDisplayName()</td>
        <td class="number">@item.Amount.ToString("c")</td>
    </tr>
}
    <tr>
        <td class="number">@Resources.Total</td>
        <td class="number">@items.Sum(x => x.Amount).ToString("c")</td>
    </tr>
</table>
}

<div id="details-section">
@if (Model.Amendments.Any()) {
    @* Counted cash never changes: the totals as signed, each correction made
       since, and the totals as they stand now. *@
    <h3>@Resources.CashCountAsSigned</h3>
    @Totals(Model.SignedByMethod)

    <h3>@Resources.CashCountAmendments</h3>
    <table>
        <tr>
            <th>@Resources.Date</th>
            <th>@Resources.Payment</th>
            <th>@Resources.Operation</th>
            <th>@Resources.Updater</th>
            <th>@Resources.MethodBefore</th>
            <th>@Resources.NetBefore</th>
            <th>@Resources.MethodAfter</th>
            <th>@Resources.NetAfter</th>
            <th>@Resources.Comment</th>
        </tr>
    @foreach (var item in Model.Amendments) {
        <tr>
            <td>@item.Time.ToString(Resources.DateTimeFormatString)</td>
            <td>@item.Payment.ToString("D8")</td>
            <td>@(Resources.ResourceManager.GetString(item.Operation) ?? item.Operation)</td>
            <td>@(item.Updater == null ? string.Empty : item.Updater.Nickname)</td>
            <td>@item.MethodBefore.GetDisplayName()</td>
            <td class="number">@item.NetBefore.ToString("c")</td>
            <td>@item.MethodAfter.GetDisplayName()</td>
            <td class="number">@item.NetAfter.ToString("c")</td>
            <td>@item.Comment</td>
        </tr>
    }
    </table>

    <h3>@Resources.CashCountCorrected</h3>
    @Totals(Model.PaymentsReceivedByMethod)
} else {
    @Totals(Model.PaymentsReceivedByMethod)
}
</div>
<div class='clearfix'></div>
<div id='back-to-list' class='pull-left'>
    @Html.ActionLink(Resources.BackToList, "Index", new { }, new { @class = "button icon back" })
</div>
<div class='pull-right'>
	@Html.ActionLink(Resources.Print, "PrintCashCount", new { id = Model.SessionId }, new { @class = "button icon print", target = "_blank" })
</div>
<div class='clearfix'></div>